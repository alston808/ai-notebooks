ocessing Text Datasets:\")\nfor row in tqdm(ds_15k, desc=\"15k Recipes\"): master_dataset.append(format_15k(row))\nfor row in tqdm(ds_recom, desc=\"Recommendations\"): master_dataset.append(format_recom(row))\nfor row in tqdm(ds_tabular, desc=\"Tabular Recipes\"): master_dataset.append(format_tabular(row))\n\nprint(\"\\n-> Processing Vision Datasets (Utilizing 4x CPU Threads)...\")\nwith ThreadPoolExecutor(max_workers=4) as executor:\n    sunny_results = list(tqdm(executor.map(format_sunny, ds_sunny), total=len(ds_sunny), desc=\"Sunny Images\"))\n    snappr_results = list(tqdm(executor.map(format_snappr, ds_snappr), total=len(ds_snappr), desc=\"Snappr Images\"))\n\nmaster_dataset.extend([r for r in sunny_results if r is not None])\nmaster_dataset.extend([r for r in snappr_results if r is not None])\n\nprint(\"\\n3. Freeing up Kaggle RAM...\")\ndel ds_15k, ds_recom, ds_tabular, ds_sunny, ds_snappr, ds_scuccorese, taxonomy\ndel sunny_results, snappr_results\ngc.collect()\n\nprint(\"4. Shuffling data...\")\nrandom.seed(42)\nrandom.shuffle(master_dataset)\nprint(f\"✅ Setup complete! Total balanced training examples: {len(master_dataset)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-18T23:33:57.570788Z","iopub.execute_input":"2026-08-18T23:33:57.571428Z"}},"outputs":[{"name":"stdout","text":"2. Processing datasets natively...\n\n-> Processing Text Datasets:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"15k Recipes:   0%|          | 0/15698 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"85947373947c4e60885c6148f3699eb6"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Recommendations:   0%|          | 0/5149 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8b536cf57d98413eadc2d9ac61b0b4aa"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"Tabular Recipes:   0%|          | 0/5000 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"5cb71f27411f4b7293a76eb07a3ddebc"}},"metadata":{}},{"name":"stdout","text":"\n-> Processing Vision Datasets (Utilizing 4x CPU Threads)...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"Sunny Images:   0%|          | 0/511 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"f38c0b1d18a9496caffdd0a8f4966f32"}},"metadata":{}}],"execution_count":null},{"cell_type":"markdown","source":"# HUGGING FACE EXPORT & DATASET CARD GENERATION","metadata":{}},{"cell_type":"code","source":"print(\"\\n5. Preparing Hugging Face Hub Export...\")\napi = HfApi()\nhf_username = api.whoami()[\"name\"]\ndataset_repo_id = f\"{hf_username}/gemma4-multimodal-recipe-dataset\"\n\nprint(f\"Target repository: https://huggingface.co/datasets/{dataset_repo_id}\")\n\nprint(\"Converting processed master list to Hugging Face Dataset...\")\nhf_dataset = Dataset.from_list(master_dataset)\n\nprint(\"Creating repository on Hub (if not already existing)...\")\ncreate_repo(repo_id=dataset_repo_id, repo_type=\"dataset\", exist_ok=True)\n\nprint(\"Pushing dataset shards to Hub...\")\nhf_dataset.push_to_hub(repo_id=dataset_repo_id, private=False)\n\ndataset_card_content = f\"\"\"---\nlicense: apache-2.0\ntask_categories:\n  - visual-question-answering\n  - text-generation\n  - image-to-text\nlanguage:\n  - en\ntags:\n  - food\n  - recipes\n  - gemma-4\n  - unsloth\n  - vision-language\n  - multimodal\nsize_categories:\n  - 10K<n<100K\n---\n\n# 🍳 Gemma 4 Multimodal Recipe & Food Dataset\n\nA balanced, high-density multimodal dataset curated specifically for fine-tuning compact vision-language models (such as `gemma-4-e2b-it`) for **visual food recognition**, **recipe generation**, and **dietary recommendation**.\n\n---\n\n## 🔗 Upstream & Source Datasets\n\nThis dataset was created by cleaning, reformatting, and synthesizing samples across the following **5** Hugging Face sources:\n\n| Dataset | Modality | Role in Pipeline |\n| :--- | :--- | :--- |\n| [`tiptoghosh/food-recipes-15k`](https://huggingface.co/datasets/tiptoghosh/food-recipes-15k) | Text / Markdown | High-structure markdown recipe generation and cooking instructions. |\n| [`azimidokht/recipe-recom`](https://huggingface.co/datasets/azimidokht/recipe-recom) | Text | Instruction tuning for nutritional filters, quick meals, and diet queries. |\n| [`jojogo9/Food_Recipes`](https://huggingface.co/datasets/jojogo9/Food_Recipes) | Tabular Text | Broad culinary knowledge and ingredient-to-step associations. |\n| [`SunnyAgarwal4274/Food_Ingredients`](https://huggingface.co/datasets/SunnyAgarwal4274/Food_Ingredients) | Vision | Raw produce and ingredient classification images. |\n| [`snappr/idefics-food-ai`](https://huggingface.co/datasets/snappr/idefics-food-ai) | Vision | High-quality plated dishes natively formatted for multimodal AI. |\n\n---\n\n## 📋 Data Structure\n\nEvery sample adheres to the standard Unsloth/Gemma conversational format:\n\n```json\n{{\n  \"messages\": [\n    {{\n      \"role\": \"user\",\n      \"content\": [\n        {{\"type\": \"image\"}}, // Present for visual queries, omitted for text-only\n        {{\"type\": \"text\", \"text\": \"What food is this, and can you give me a recipe for it?\"}}\n      ]\n    }},\n    {{\n      \"role\": \"assistant\",\n      \"content\": [\n        {{\"type\": \"text\", \"text\": \"This looks like pizza! Here is a quick way to prepare it: ...\"}}\n      ]\n    }}\n  ],\n  \"image\": \"<PIL.Image null or>\"\n}}\n```\n## 🛠️ Usage with Unsloth / Hugging Face\n\nfrom datasets import load_dataset\n\ndataset = load_dataset(\"{dataset_repo_id}\", split=\"train\")\nprint(dataset[0])\n\"\"\"\n\nreadme_path = \"DATASET_README.md\"\nwith open(readme_path, \"w\", encoding=\"utf-8\") as f:\n    f.write(dataset_card_content)\n\nprint(\"Uploading Dataset Card (README.md) to Hugging Face...\")\napi.upload_file(\npath_or_fileobj=readme_path,\npath_in_repo=\"README.md\",\nrepo_id=dataset_repo_id,\nrepo_type=\"dataset\"\n)\n\nprint(f\"\\n🎉 Dataset & Card successfully published to: https://huggingface.co/datasets/{dataset_repo_id}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Initialize Unsloth Model","metadata":{}},{"cell_type":"code","source":"import torch\nfrom unsloth import FastVisionModel\nfrom unsloth.trainer import UnslothVisionDataCollator\nfrom trl import SFTTrainer\nfrom transformers import TrainingArguments\n\nprint(\"1. Loading Unsloth Model...\")\nmodel_id = \"google/gemma-4-e2b-it\" \n\nmodel, processor = FastVisionModel.from_pretrained(\n    model_name = model_id,\n    load_in_4bit = True,\n    use_gradient_checkpointing = \"unsloth\", \n)\n\nmodel = FastVisionModel.get_peft_model(\n    model,\n    finetune_vision_layers = True,     \n    finetune_language_layers = True,   \n    finetune_attention_modules = True,\n    finetune_mlp = True,\n    r = 16,\n    lora_alpha = 32,\n    lora_dropout = 0,\n    bias = \"none\",\n)\n\nprint(\"2. Configuring CPU-Optimized Training Arguments...\")\ntraining_args = TrainingArguments(\n    output_dir                  = \"./gemma-4-recipe-model\",\n    per_device_train_batch_size = 2,\n    gradient_accumulation_steps = 4,              \n    learning_rate               = 2e-4,\n    lr_scheduler_type           = \"cosine\",       \n    warmup_ratio                = 0.03,\n    max_steps                   = 2500,           \n    logging_steps               = 50,\n    save_steps                  = 500,\n    save_total_limit            = 2,\n    fp16                        = not torch.cuda.is_bf16_supported(),\n    bf16                        = torch.cuda.is_bf16_supported(),\n    optim                       = \"adamw_8bit\",   \n    weight_decay                = 0.01,\n    seed                        = 3407,\n    remove